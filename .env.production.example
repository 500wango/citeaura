DOMAIN=example.com
APP_PORT=18000

# Neon pooled connection string. Keep sslmode=require and quote this line if the password has shell characters.
DATABASE_URL="postgresql+psycopg2://neondb_owner:replace-with-neon-password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
PUBLIC_BASE_URL=https://example.com
OIDC_ALLOW_INSECURE_LOCALHOST=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REDIS_URL=redis://redis:6379/0
PROJECT_LOCK_TTL_SECONDS=60
PROJECT_LOCK_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY_HEADERS=true
JWT_SECRET=replace-with-a-long-random-secret
AES_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_COOKIE_SECURE=true
BILLING_ANNUAL_DISCOUNT_PERCENT=16.67
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cny
PASSWORD_RESET_TTL_MINUTES=30
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=CiteAura

# S3 兼容对象存储归档。endpoint 留空时使用 AWS S3。
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=citeaura-archives
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
OBJECT_STORAGE_RETENTION_COUNT=12

# 平台代付 Key 池：只在项目明确启用且租户没有对应 BYOK 时使用。
PLATFORM_POOL_PRICES_CNY_FEN={"deepseek":50,"openai":50}
PLATFORM_POOL_ZHIPUAI_API_KEY=
PLATFORM_POOL_ARK_API_KEY=
PLATFORM_POOL_DEEPSEEK_API_KEY=
PLATFORM_POOL_MOONSHOT_API_KEY=
PLATFORM_POOL_MINIMAX_API_KEY=
PLATFORM_POOL_GEMINI_API_KEY=
PLATFORM_POOL_OPENAI_API_KEY=
PLATFORM_POOL_ANTHROPIC_API_KEY=
PLATFORM_POOL_XAI_API_KEY=
PLATFORM_POOL_PERPLEXITY_API_KEY=
