DOMAIN=example.com
APP_PORT=18000

# Keep this pointed at the existing physical Docker volume. Set the old
# volume name and CITEAURA_WORK_EXTERNAL=true during a work-volume recovery.
CITEAURA_WORK_VOLUME=citeaura_citeaura_work
CITEAURA_WORK_EXTERNAL=false

# Database target. Keep the Neon URL during the rehearsal phase. For the final
# same-host Compose cutover, set DATABASE_URL to the postgres service URL below.
# 单引号阻止 Compose/shell 对密码里的 $ 和反引号做展开。
DATABASE_URL='postgresql+psycopg2://neondb_owner:replace-with-neon-password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require'
# Used only when DATABASE_URL points to the local Compose postgres service.
POSTGRES_MAJOR=18
POSTGRES_DB=citeaura
POSTGRES_USER=citeaura
POSTGRES_PASSWORD='replace-with-a-long-random-postgres-password'
PUBLIC_BASE_URL=https://example.com
REDIS_PASSWORD='replace-with-a-long-random-redis-password'
REDIS_URL='redis://:replace-with-a-long-random-redis-password@redis:6379/0'
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
PROJECT_LOCK_TTL_SECONDS=60
PROJECT_LOCK_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY_HEADERS=true
# 宿主机 Caddy 通过 Docker 端口映射访问 API，源地址可能是网桥网段。
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
PRODUCTION_PROXY_MODE=true
ALLOWED_HOSTS=
TRUST_CLOUDFLARE_COUNTRY_HEADER=false
JWT_SECRET='replace-with-a-long-random-secret'
AES_KEY='replace-with-a-base64-encoded-32-byte-key'
SESSION_COOKIE_SECURE=true
# Enable only after live Stripe keys and the production webhook are configured.
BILLING_ENABLED=false
BILLING_ANNUAL_DISCOUNT_PERCENT=16.67
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# SMTP is used for welcome emails, payment notifications, password resets, delivery shares, and alerts.
# Password reset links additionally require PASSWORD_RESET_EMAIL_ENABLED=true.
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=CiteAura

# S3 兼容对象存储归档。endpoint 留空时使用 AWS S3。
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=citeaura-archives
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
OBJECT_STORAGE_RETENTION_COUNT=12

# 平台代付 Key 池：只在项目明确启用且租户没有对应 BYOK 时使用。
PLATFORM_POOL_PRICES_CNY_FEN={"deepseek":50,"openai":50}
PLATFORM_POOL_ZHIPUAI_API_KEY=
PLATFORM_POOL_ARK_API_KEY=
PLATFORM_POOL_DEEPSEEK_API_KEY=
PLATFORM_POOL_MOONSHOT_API_KEY=
PLATFORM_POOL_MINIMAX_API_KEY=
PLATFORM_POOL_GEMINI_API_KEY=
PLATFORM_POOL_OPENAI_API_KEY=
PLATFORM_POOL_ANTHROPIC_API_KEY=
PLATFORM_POOL_XAI_API_KEY=
PLATFORM_POOL_PERPLEXITY_API_KEY=

# 采样与效果验证灰度开关。
CITEAURA_DEFAULT_REPEAT=5
CITEAURA_CLUSTER_STATS=true
CITEAURA_EFFECT_VERIFICATION=true
CITEAURA_ISOLATED_JOBS=true
CITEAURA_TRIAL_POOL=true
# 引擎子进程超时；必须小于长任务软超时（默认 7200s），父进程才能先回收进程组。
CITEAURA_ENGINE_JOB_TIMEOUT=7140
WORKER_LONG_TASK_SOFT_TIME_LIMIT=7200
WORKER_CONCURRENCY=4
CITEAURA_TRIAL_BUDGET_CNY_FEN=1440
CITEAURA_TENANT_STORAGE_QUOTA_MB=2048
CITEAURA_PROJECT_RETENTION_DAYS=90

# Google Search Console / Google Analytics 4 一次性读取（只读 scope，不保存 refresh token）。
# 回调地址：<PUBLIC_BASE_URL>/api/v1/searchdata/gsc/callback，两个功能共用；未配置时前端隐藏入口。
# GA4 需要 consent screen 额外包含 analytics.readonly，并启用 Google Analytics Admin API 与 Data API。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
