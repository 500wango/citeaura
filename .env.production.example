DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=disvorai
POSTGRES_USER=disvorai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://disvorai:replace-with-a-long-random-password@postgres:5432/disvorai
PUBLIC_BASE_URL=https://example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REDIS_URL=redis://redis:6379/0
PROJECT_LOCK_TTL_SECONDS=60
PROJECT_LOCK_WAIT_SECONDS=10
JWT_SECRET=replace-with-a-long-random-secret
AES_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_COOKIE_SECURE=true
BILLING_ANNUAL_DISCOUNT_PERCENT=16.67
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cny

# 平台代付 Key 池：只在项目明确启用且租户没有对应 BYOK 时使用。
PLATFORM_POOL_PRICES_CNY_FEN={"deepseek":50,"openai":50}
