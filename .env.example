DATABASE_URL=postgresql+psycopg2://citeaura:citeaura@localhost:5432/citeaura
PUBLIC_BASE_URL=http://localhost:8000
OIDC_ALLOW_INSECURE_LOCALHOST=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379/0
PROJECT_LOCK_TTL_SECONDS=60
PROJECT_LOCK_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# Enable only when the origin accepts traffic exclusively from Cloudflare or Cloudflare Tunnel.
TRUST_CLOUDFLARE_COUNTRY_HEADER=false
JWT_SECRET=replace-with-a-long-random-secret
AES_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_COOKIE_SECURE=false
# Enable only after Stripe keys and a webhook are configured.
BILLING_ENABLED=false
BILLING_ANNUAL_DISCOUNT_PERCENT=16.67
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Enable only after the authentication email SMTP account is configured.
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=CiteAura

# S3 兼容对象存储归档。endpoint 留空时使用 AWS S3。
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=citeaura-archives
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_RETENTION_COUNT=12

# 平台代付 Key 池：只在项目明确启用且租户没有对应 BYOK 时使用。
PLATFORM_POOL_PRICES_CNY_FEN={"openai":50,"gemini":50}
PLATFORM_POOL_GEMINI_API_KEY=
PLATFORM_POOL_OPENAI_API_KEY=
PLATFORM_POOL_ANTHROPIC_API_KEY=
PLATFORM_POOL_XAI_API_KEY=
PLATFORM_POOL_PERPLEXITY_API_KEY=
