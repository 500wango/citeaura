{
  "name": "CiteAura",
  "short_name": "CiteAura",
  "description": "Measure AI brand visibility, audit your public site, turn evidence into engineering tickets, and verify changes.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#f7f9fa",
  "theme_color": "#f7f9fa",
  "icons": [
    {
      "src": "/site-assets/favicon.png?v=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/site-assets/icon-192.png?v=1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/site-assets/apple-touch-icon.png?v=1",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
